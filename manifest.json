{
  "manifest_version": 3,
  "name": "Globalization Suite",
  "description": "Internal tools created by the Globalization team + AEM Loader",
  "version": "3.0",
  "permissions": [
    "scripting",
    "activeTab",
    "clipboardWrite",
    "tabGroups",
    "storage"
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "128": "icons/globe-adm.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "core/helperAutoExecute.js"
      ]
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/globe-adm.png",
    "48": "icons/globe-adm.png",
    "128": "icons/globe-adm.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/globe-adm.png",
        "icons/globe-adm-off.png",
        "main/open-urls.js",
        "main/publish.js",
        "scripts/info-utilities/copy-date.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}